{
  "manifest_version": 3,
  "name": "WPFind",
  "version": "0.1.0",
  "description": "Search every WordPress admin menu and submenu from one popup.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WPFind",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["activeTab", "scripting"]
}
